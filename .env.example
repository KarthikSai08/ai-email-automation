# Copy this file to .env and fill in your real values.
# .env is git-ignored — never commit it.

# Department routing — destination addresses per department.
# Empty value = not configured -> falls back to DEFAULT_EMAIL.
DEPARTMENT_HR=hr@example.com
DEPARTMENT_STORE=store@example.com
DEPARTMENT_DELIVERY=delivery@example.com
DEPARTMENT_CRM=crm@example.com
DEPARTMENT_FINANCE=
DEPARTMENT_PURCHASE=
DEPARTMENT_RECYCLE=
DEPARTMENT_SALES=
DEPARTMENT_SPAM=
DEPARTMENT_SUPPORT=

# Unclassified / unknown-department fallback
DEFAULT_DEPARTMENT=PERSONAL
DEFAULT_EMAIL=you@example.com

# GCP — match the values you used with `just watch`
GCP_PROJECT_ID=your-gcp-project-id
PUBSUB_TOPIC=projects/your-gcp-project-id/topics/gmail-new-mail
PUBSUB_SUBSCRIPTION_ID=your-subscription-id

# API server
API_HOST=127.0.0.1
API_PORT=8000